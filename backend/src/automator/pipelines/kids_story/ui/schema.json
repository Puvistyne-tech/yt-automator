{
  "sections": [
    {"id": "series", "title": "Series", "description": "Name, look and voice of the whole series.", "fields": ["series", "cast"]},
    {"id": "story", "title": "Story", "description": "How each story is written and checked.", "fields": ["story", "safety"]},
    {"id": "pictures", "title": "Pictures and motion", "description": "Scene pictures, vertical pictures and animation.", "fields": ["visuals"]},
    {"id": "sound", "title": "Sound", "description": "Narration, music and sound effects.", "fields": ["voice", "music", "sound_effects"]},
    {"id": "subtitles", "title": "Subtitles", "description": "Subtitles drawn on the video and uploaded as captions.", "fields": ["subtitles"]},
    {"id": "videos", "title": "Videos", "description": "The 16:9 episode and the 9:16 Short.", "fields": ["episode", "short"]},
    {"id": "publishing", "title": "Publishing", "description": "Thumbnail, titles, descriptions and tags.", "fields": ["thumbnail", "metadata"]},
    {"id": "quality", "title": "Quality checks", "description": "How runs are scored before review.", "fields": ["quality"]}
  ],
  "order": {
    "series": ["name", "tagline", "art_style", "negative_prompt", "refrain", "intro_line", "outro_line", "editorial_rules"],
    "cast": ["id", "name", "species", "visual_descriptor", "personality", "palette", "voice_override"],
    "story": ["source", "primary_language", "theme_mode", "themes", "fixed_theme", "recent_themes", "avoid_repeat_last", "morals", "age_min", "age_max", "target_duration_seconds", "duration_tolerance_seconds", "scene_count_min", "scene_count_max", "words_per_scene_min", "words_per_scene_max", "words_per_minute", "reading_level", "max_average_sentence_words", "long_word_graphemes", "max_long_word_share", "ending_scenes", "question_count", "temperature", "translation_temperature", "max_tokens", "max_attempts"],
    "short": ["enabled", "resolution", "max_duration_seconds", "scene_selection", "first_n_scenes", "max_scenes", "hook_line"]
  },
  "widgets": {
    "series.art_style": {"widget": "textarea", "rows": 3},
    "series.negative_prompt": {"widget": "textarea", "rows": 3},
    "series.intro_line.en": {"widget": "textarea", "rows": 2},
    "series.intro_line.ta": {"widget": "textarea", "rows": 2},
    "series.outro_line.en": {"widget": "textarea", "rows": 2},
    "series.outro_line.ta": {"widget": "textarea", "rows": 2},
    "cast.visual_descriptor": {"widget": "textarea", "rows": 3},
    "cast.personality": {"widget": "textarea", "rows": 2},
    "cast.palette": {"widget": "color"},
    "story.source": {"widget": "select"},
    "story.primary_language": {"widget": "select"},
    "story.theme_mode": {"widget": "radio"},
    "story.reading_level": {"widget": "select"},
    "story.temperature": {"widget": "slider", "step": 0.05},
    "story.translation_temperature": {"widget": "slider", "step": 0.05},
    "story.max_long_word_share": {"widget": "slider", "step": 0.01},
    "visuals.motion_intensity": {"widget": "slider", "step": 0.05},
    "visuals.hero_motion_intensity": {"widget": "slider", "step": 0.05},
    "visuals.crop_focus": {"widget": "slider", "step": 0.05},
    "visuals.short_art_mode": {"widget": "radio"},
    "visuals.badge_corner": {"widget": "select"},
    "visuals.badge_size_ratio": {"widget": "slider", "step": 0.005},
    "visuals.card_camera": {"widget": "select"},
    "voice.speed": {"widget": "slider", "step": 0.05},
    "music.mood_prompt": {"widget": "textarea", "rows": 2},
    "music.volume": {"widget": "slider", "step": 0.01},
    "music.ducking": {"widget": "slider", "step": 0.05},
    "sound_effects.volume": {"widget": "slider", "step": 0.05},
    "subtitles.primary_color": {"widget": "color"},
    "subtitles.outline_color": {"widget": "color"},
    "subtitles.highlight_color": {"widget": "color"},
    "episode.resolution": {"widget": "select"},
    "short.resolution": {"widget": "select"},
    "short.scene_selection": {"widget": "radio"},
    "thumbnail.text_position": {"widget": "radio"},
    "thumbnail.text_color": {"widget": "color"},
    "thumbnail.outline_color": {"widget": "color"},
    "thumbnail.jpeg_quality": {"widget": "slider", "step": 1},
    "thumbnail.min_jpeg_quality": {"widget": "slider", "step": 1},
    "thumbnail.downscale_step": {"widget": "slider", "step": 0.05},
    "metadata.description_template.en": {"widget": "textarea", "rows": 10},
    "metadata.description_template.ta": {"widget": "textarea", "rows": 10},
    "metadata.category": {"widget": "select"},
    "quality.subtitle_min_coverage": {"widget": "slider", "step": 0.01},
    "quality.subtitle_overlap_penalty": {"widget": "slider", "step": 0.05},
    "quality.subtitle_out_of_bounds_penalty": {"widget": "slider", "step": 0.05}
  }
}
