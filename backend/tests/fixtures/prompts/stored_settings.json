{
  "series": {
    "name": {
      "en": "Story Time",
      "ta": "கதை நேரம்"
    },
    "tagline": {
      "en": "Gentle stories for little hearts",
      "ta": "சின்ன மனங்களுக்கு இனிய கதைகள்"
    },
    "refrain": {
      "en": "Be kind, be brave, be you!",
      "ta": "அன்பாக இரு, துணிவாக இரு, நீயாகவே இரு!"
    },
    "intro_line": {
      "en": "Hello, little friends! Welcome to {series}. Let's begin!",
      "ta": "வணக்கம், சின்ன நண்பர்களே! {series} உங்களை அன்புடன் வரவேற்கிறது. கதையைத் தொடங்குவோம்!"
    },
    "outro_line": {
      "en": "Thank you for listening, little friends. See you in the next story!",
      "ta": "கதையைக் கேட்டதற்கு நன்றி, சின்ன நண்பர்களே. அடுத்த கதையில் சந்திப்போம்!"
    },
    "editorial_rules": [
      "Every story is gentle, warm and safe for children aged three to seven.",
      "No violence, fear, danger, villains, punishment or unsafe behaviour.",
      "Problems are small and everyday, and the friends solve them by being kind.",
      "No brands, products, real people, places of worship or current events.",
      "Use short sentences and simple words a young child understands.",
      "End with the moral said plainly, then the series refrain."
    ]
  },
